APP_NAME=Volymoly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://volymoly.com

# Frontend origins allowed to call this API. Comma-separate local and
# production origins when both are needed.
FRONTEND_URL=https://volymolystudio-frontend.vercel.app
# The first FRONTEND_URL origin is the fixed post-login destination.
# OAuth returns through the frontend proxy to retain the browser session.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://volymolystudio-frontend.vercel.app/api/auth/google/callback
SANCTUM_STATEFUL_DOMAINS=volymolystudio-frontend.vercel.app,localhost:3000,127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=laravel_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS="no-reply@volymoly.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Enable after the approved activity page is deployed; no page is invented.
NEW_DEVICE_ALERTS_ENABLED=false
LOGIN_ACTIVITY_REVIEW_PATH=
# Same private random 32+ character value in Laravel and Next.js.
AUTH_PROXY_SECRET=

# Auth security data-retention windows.
AUTH_VERIFICATION_RETENTION_DAYS=1
AUTH_RECOVERY_RETENTION_DAYS=30
AUTH_ACTIVITY_RETENTION_DAYS=90
AUTH_DEVICE_RETENTION_DAYS=180
